{
  "name": "@wangzf/dsh-openai-codex-oauth",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Model-independent entry to Harness built-in Codex authorization",
  "engines": { "dsh": "0.2.2-rc.2" },
  "exports": {
    ".": "./src/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["src", "scripts", "tests", "dist/client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "TESTING.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs && node --check dist/client.js"
  }
}
